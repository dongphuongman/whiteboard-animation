# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env
# .env đã nằm trong .gitignore, KHÔNG commit key thật.

# ===================================================
# Giọng đọc (Text-to-Speech)
# ===================================================
# Engine mặc định: edge (miễn phí, cần internet), vbee (trả phí theo ký tự),
# hoặc vietneu (offline on-device, miễn phí sau lần tải model đầu ~230MB)
TTS_PROVIDER=edge

# Giọng mặc định:
# - Edge: vi-VN-NamMinhNeural (nam), vi-VN-HoaiMyNeural (nữ)
# - Vbee: dán nguyên mã giọng (voice_code) copy từ giao diện Vbee,
#         vd n_hanoi_male_protrainer_education_vc
# - VietNeu: tên preset, vd Minh Đức (nam Bắc tin tức), Hải Đăng, Mai Anh (nữ)
TTS_VOICE=vi-VN-NamMinhNeural

# Tốc độ đọc: 1.0 = bình thường, 1.1 = nhanh hơn 10%, 0.9 = chậm hơn (khoảng 0.1 - 1.9)
TTS_SPEED=1.05

# Giọng VietNeu khi TTS_PROVIDER=vietneu (để trống = Minh Đức).
# VIETNEU_PRECISION: int8 (nhanh, mặc định) hoặc fp32 (chất lượng tối đa).
# VIETNEU_MODEL_DIR: thư mục model (mặc định ~/.cache/whiteboard-video/vieneu/backbone).
VIETNEU_VOICE=
VIETNEU_PRECISION=int8
VIETNEU_MODEL_DIR=

# ===================================================
# Vbee TTS API (chỉ cần khi TTS_PROVIDER=vbee) — đăng ký tại https://vbee.vn
# ===================================================
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=

# ===================================================
# Tạo ảnh nét vẽ (scripts/generate_images.py)
# ===================================================
# Engine: gemini (key miễn phí tại https://aistudio.google.com/apikey),
#      openai (gpt-image-1, trả phí),
#      agnes (agnes-image-2.5-flash, hiện miễn phí)
IMG_PROVIDER=gemini

# Model tạo ảnh (để trống = mặc định của engine):
# - Gemini: gemini-2.5-flash-image
# - OpenAI: gpt-image-1
# - Agnes: agnes-image-2.5-flash
IMG_MODEL=

GEMINI_API_KEY=
OPENAI_API_KEY=
AGNES_API_KEY=
